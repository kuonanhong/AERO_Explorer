side":"R","t":214.98,"dist":23764,"tt":7498,"src":[8]},"fuji":{"zh":"富士山","en":"Mount Fuji","label":{"zh":"富士山","en":"Mount Fuji"},"lat":35.36083,"lon":138.7275,"h":3776,"side":"L","t":255.23,"dist":27237,"tt":9093,"src":[9]}},"shots":[{"t0":0.0,"dur":4.0,"zh":[],"en":[]},{"t0":4.0,"dur":13.0,"zh":["桃園國際機場起飛，前往東京羽田機場。","這座機場位在台北以西約 40 公里，是台灣最大、最繁忙的機場。"],"en":["Taking off from Taoyuan International Airport, bound for Tokyo Haneda.","About 40 km west of Taipei, it is Taiwan's largest and busiest airport."]},{"t0":17.0,"dur":8.11,"zh":[],"en":[]},{"t0":25.11,"dur":13.0,"zh":["右側是七星山，海拔 1,120 公尺，台北市最高峰。","它也是台灣最高的休火山，位在陽明山國家公園中央。"],"en":["On the right: Mount Qixing, 1,120 m, the highest peak in Taipei.","It is also Taiwan's highest dormant volcano, at the heart of Yangmingshan National Park."],"poi":"qixing"},{"t0":38.11,"dur":9.74,"zh":[],"en":[]},{"t0":47.85,"dur":13.0,"zh":["右下方海上是彭佳嶼，距基隆港約 56 公里。","島上燈塔 1909 年啟用，現列為古蹟。"],"en":["Below on the right: Pengjia Islet, about 56 km from Keelung Port.","Its lighthouse first shone in 1909 and is now a protected historic monument."],"poi":"pengjia"},{"t0":60.85,"dur":74.45,"zh":[],"en":[]},{"t0":135.3,"dur":19.5,"zh":["右側遠方是屋久島，1993 年列入世界自然遺產。","最高峰宮之浦岳海拔 1,936 公尺。","這裡的年雨量可達 4,000 到 10,000 毫米。"],"en":["Far to the right: Yakushima, a natural World Heritage Site since 1993.","Its highest peak, Mount Miyanoura, rises to 1,936 m.","Rainfall here can reach 4,000 to 10,000 mm a year."],"poi":"yakushima"},{"t0":154.8,"dur":33.63,"zh":[],"en":[]},{"t0":188.43,"dur":13.0,"zh":["左側是四國東南端的室戶岬，屬於室戶世界地質公園。","這裡的陸地抬升速度，名列世界前茅。"],"en":["On the left: Cape Muroto, at the south-east tip of Shikoku, in the Muroto UNESCO Global Geopark.","The land here is rising at some of the world's fastest rates."],"poi":"muroto"},{"t0":201.43,"dur":7.7,"zh":[],"en":[]},{"t0":209.13,"dur":13.0,"zh":["右側是潮岬，本州的最南端。","日本常以它為基準，報告颱風的位置。"],"en":["On the right: Cape Shionomisaki, the southernmost point of Honshu.","Japan often uses it as the reference point for where a typhoon is."],"poi":"shiono"},{"t0":222.13,"dur":24.33,"zh":[],"en":[]},{"t0":246.45,"dur":19.5,"zh":["左側是富士山，海拔 3,776 公尺，日本最高峰。","最後一次噴發在 1707 到 1708 年。","2013 年列入世界文化遺產。"],"en":["On the left: Mount Fuji, 3,776 m, the highest mountain in Japan.","It last erupted in 1707–1708.","It became a cultural World Heritage Site in 2013."],"poi":"fuji"},{"t0":265.95,"dur":11.55,"zh":[],"en":[]},{"t0":277.5,"dur":13.0,"zh":["降落東京國際機場，一般稱作羽田機場，1931 年啟用。","機場位在大田區，距東京車站約 15 公里。"],"en":["Landing at Tokyo International Airport, known as Haneda, opened in 1931.","It lies in Ōta, about 15 km south of Tokyo Station."]},{"t0":290.5,"dur":9.5,"zh":[],"en":[]}],"log":[{"t":0.0,"tt":0,"kind":"dep","zh":"起飛：臺灣桃園國際機場","en":"Takeoff: Taiwan Taoyuan International Airport"},{"t":30.96,"tt":280,"kind":"poi","zh":"右側 12 公里：七星山","en":"Mount Qixing, 12 km right","k":"qixing"},{"t":53.7,"tt":704,"kind":"poi","zh":"右側 3 公里：彭佳嶼","en":"Pengjia Islet, 3 km right","k":"pengjia"},{"t":62.56,"tt":952,"kind":"toc","zh":"爬升至巡航高度 37,000 呎","en":"Top of climb, 37,000 ft"},{"t":144.07,"tt":4917,"kind":"poi","zh":"右側 55 公里：屋久島","en":"Yakushima, 55 km right","k":"yakushima"},{"t":194.28,"tt":6914,"kind":"poi","zh":"左側 34 公里：室戶岬","en":"Cape Muroto, 34 km left","k":"muroto"},{"t":214.98,"tt":7498,"kind":"poi","zh":"右側 24 公里：潮岬","en":"Cape Shionomisaki, 24 km right","k":"shiono"},{"t":234.62,"tt":8296,"kind":"tod","zh":"開始下降","en":"Top of descent"},{"t":255.23,"tt":9093,"kind":"poi","zh":"左側 27 公里：富士山","en":"Mount Fuji, 27 km left","k":"fuji"},{"t":300.0,"tt":9900,"kind":"arr","zh":"降落：東京國際機場（羽田）","en":"Landing: Tokyo International Airport (Haneda)"}],"note":{"zh":"模擬畫面：航路取兩機場間的大圓航線，高度、速度與時間依一般客機爬升下降推算，並非實際航班紀錄；大部分雲層已移除。","en":"Simulation: a great-circle path between the airports, with height, speed and times estimated from typical airliner climbs and descents. Not a real flight record; most clouds are removed."},"geo_src":"great circle between the airports","sources":[{"title":"OpenStreetMap contributors (O